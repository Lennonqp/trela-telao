rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quem é quem ----------
    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    // Equipe: contas com um documento em /equipe/{uid} (criado à mão no console)
    function equipe() { return logado() && exists(/databases/$(database)/documents/equipe/$(eu())); }
    // Conta anônima: só a TV usa (pra mostrar o código de pareamento). Não posta nem conversa.
    function anonimo() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    // Pessoa de verdade (Google ou e-mail), não a TV
    function pessoa() { return logado() && !anonimo(); }
    // Conta ativa: pessoa logada e não suspensa pela equipe
    function ativo() { return pessoa() && !exists(/databases/$(database)/documents/suspensos/$(eu())); }
    // TV pareada pela equipe (conta anônima liberada em /telas)
    function tela() { return logado() && exists(/databases/$(database)/documents/telas/$(eu())); }

    function nomeOk(n) { return n is string && n.size() >= 1 && n.size() <= 20; }
    function textoOk(t, min, max) { return t is string && t.size() >= min && t.size() <= max; }
    function agora(d) { return d.criado == request.time; }
    function corOk(c) { return c in ['neon', 'lilas', 'laranja']; }

    // Segunda barreira do filtro (a primeira fica na página)
    function suspeito(t) {
      return t.lower().matches('(?s).*\\b(porra|caralh\\w*|merda|puta|puto|fdp|vsf|pqp|buceta|arromb\\w*|desgra\\w*|vagabund\\w*|viado|corno|foda|fodase|fuder|fudid\\w*|cuzao|piroca|vadia|piranha|macaco|retardad\\w*|otario|nazista)\\b.*')
        || t.lower().matches('(?s).*(https?://|www[.]|[.]com\\b).*')
        || t.matches('(?s).*[0-9]{8}.*');
    }

    function amizade(par) { return get(/databases/$(database)/documents/amizades/$(par)).data; }
    function amigos(par) { return amizade(par).status == 'aceita' && eu() in amizade(par).membros; }
    function bloqueado(a, b) {
      return exists(/databases/$(database)/documents/bloqueios/$(a + '_' + b))
          || exists(/databases/$(database)/documents/bloqueios/$(b + '_' + a));
    }

    // ---------- Equipe e suspensões ----------
    match /equipe/{uid} {
      allow read: if logado() && uid == eu();
      allow write: if false;
    }
    match /suspensos/{uid} {
      allow read: if logado() && (uid == eu() || equipe());
      allow write: if equipe();
    }

    // ---------- TVs (pareamento por código) ----------
    // A TV anônima cria /pareamentos/{código}; a equipe digita o código em /bar,
    // cria /telas/{uid da TV} e apaga o pareamento.
    match /pareamentos/{codigo} {
      allow create: if logado() && anonimo()
        && codigo.matches('[0-9]{6}')
        && request.resource.data.keys().hasOnly(['uid', 'criado'])
        && request.resource.data.uid == eu()
        && request.resource.data.criado == request.time;
      allow read: if equipe() || (logado() && resource.data.uid == eu());
      allow delete: if equipe() || (logado() && resource.data.uid == eu());
    }
    match /telas/{uid} {
      allow read: if logado() && (uid == eu() || equipe());
      allow create: if equipe() && request.resource.data.keys().hasOnly(['nome', 'criado'])
        && request.resource.data.criado == request.time;
      allow delete: if equipe();
    }

    // ---------- Perfis ----------
    match /usuarios/{uid} {
      allow read: if logado();
      allow create, update: if pessoa() && uid == eu()
        && request.resource.data.keys().hasOnly(['nome', 'cor', 'criado', 'ultimoAcesso', 'fotoV', 'aberto'])
        && (request.resource.data.get('aberto', null) == null || request.resource.data.aberto == request.time || request.resource.data.aberto == resource.data.get('aberto', null))
        && nomeOk(request.resource.data.nome) && !suspeito(request.resource.data.nome)
        && request.resource.data.ultimoAcesso == request.time;
      // Excluir a própria conta
      allow delete: if logado() && uid == eu();
    }

    // ---------- Fotos de perfil (cada um só mexe na sua; a equipe pode remover) ----------
    match /avatares/{uid} {
      allow read: if logado();
      allow create, update: if ativo() && uid == eu()
        && request.resource.data.keys().hasOnly(['data', 'criado'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 120000
        && request.resource.data.data.matches('data:image/jpeg;base64,.*')
        && request.resource.data.criado == request.time;
      allow delete: if logado() && (uid == eu() || equipe());
    }

    // ---------- Amizades (id = uidMenor_uidMaior) ----------
    match /amizades/{par} {
      allow read: if logado() && eu() in resource.data.membros;
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['membros', 'de', 'para', 'status', 'criado'])
        && request.resource.data.de == eu()
        && request.resource.data.status == 'pendente'
        && request.resource.data.membros.size() == 2
        && request.resource.data.membros[0] < request.resource.data.membros[1]
        && par == request.resource.data.membros[0] + '_' + request.resource.data.membros[1]
        && eu() in request.resource.data.membros
        && request.resource.data.para in request.resource.data.membros
        && request.resource.data.para != eu()
        && !bloqueado(eu(), request.resource.data.para)
        && agora(request.resource.data);
      // Deu match (os dois marcaram interesse): a amizade já nasce aceita
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['membros', 'de', 'para', 'status', 'criado'])
        && request.resource.data.de == eu()
        && request.resource.data.status == 'aceita'
        && request.resource.data.membros.size() == 2
        && request.resource.data.membros[0] < request.resource.data.membros[1]
        && par == request.resource.data.membros[0] + '_' + request.resource.data.membros[1]
        && eu() in request.resource.data.membros
        && request.resource.data.para in request.resource.data.membros
        && request.resource.data.para != eu()
        && exists(/databases/$(database)/documents/matches/$(par))
        && !bloqueado(eu(), request.resource.data.para)
        && agora(request.resource.data);
      // Só quem recebeu o pedido aceita
      allow update: if ativo() && resource.data.para == eu() && resource.data.status == 'pendente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'aceita';
      // Recusar, cancelar ou desfazer: qualquer um dos dois
      allow delete: if logado() && eu() in resource.data.membros;
    }

    // ---------- Bloqueios (id = quemBloqueou_bloqueado) ----------
    match /bloqueios/{id} {
      allow read: if logado() && resource.data.de == eu();
      allow create: if pessoa() && request.resource.data.de == eu()
        && request.resource.data.keys().hasOnly(['de', 'alvo', 'criado'])
        && id == eu() + '_' + request.resource.data.alvo;
      allow delete: if logado() && resource.data.de == eu();
    }

    // ---------- Conversas privadas (só entre amigos) ----------
    match /conversas/{par} {
      allow read: if logado() && eu() in resource.data.membros;
      allow create, update: if ativo() && amigos(par)
        && request.resource.data.membros == amizade(par).membros
        && request.resource.data.keys().hasOnly(['membros', 'ultima', 'lidaPor', 'apagadaPor']);

      match /mensagens/{m} {
        allow read: if logado() && amigos(par);
        allow create: if ativo() && amigos(par)
          && request.resource.data.keys().hasOnly(['de', 'texto', 'criado'])
          && request.resource.data.de == eu()
          && textoOk(request.resource.data.texto, 1, 500)
          && agora(request.resource.data);
        // "Apagar pra nós dois": qualquer um dos dois amigos apaga as mensagens da conversa
        allow delete: if logado() && amigos(par);
      }
    }

    // ---------- Avisos (marcações) ----------
    match /avisos/{uid}/itens/{id} {
      allow create: if ativo() && uid != eu()
        && request.resource.data.keys().hasOnly(['tipo', 'de', 'deNome', 'postId', 'texto', 'criado', 'lida'])
        && request.resource.data.de == eu() && request.resource.data.lida == false
        && textoOk(request.resource.data.texto, 0, 60) && agora(request.resource.data);
      allow read, update, delete: if logado() && uid == eu();
    }

    // ---------- Denúncias ----------
    match /denuncias/{id} {
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['de', 'deNome', 'contra', 'contraNome', 'texto', 'criado'])
        && request.resource.data.de == eu() && textoOk(request.resource.data.texto, 0, 500)
        && agora(request.resource.data);
      allow read, delete: if equipe();
    }

    // ---------- Fila do balcão (fotos e o que o filtro achou suspeito) ----------
    match /fila/{id} {
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['tipo', 'autor', 'nome', 'texto', 'cor', 'criado', 'motivo', 'fotoId', 'alvo', 'alvoTexto', 'mencoes'])
        && request.resource.data.autor == eu()
        && request.resource.data.tipo in ['recado', 'foto', 'comentario']
        && nomeOk(request.resource.data.nome) && textoOk(request.resource.data.texto, 0, 120)
        && corOk(request.resource.data.cor) && agora(request.resource.data);
      allow read, delete: if equipe();
    }

    // ---------- Fotos (o post guarda só o id) ----------
    match /fotos/{id} {
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['data', 'criado'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 700000
        && request.resource.data.data.matches('data:image/jpeg;base64,.*')
        && agora(request.resource.data);
      allow read: if logado();
      allow delete: if equipe();
    }

    // ---------- Telão e feed "Rolou hoje" ----------
    function reacaoValida() {
      let a = resource.data.reacoes;
      let n = request.resource.data.reacoes;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacoes'])
        && n.keys().hasOnly(['fogo', 'riso', 'amor'])
        && n.fogo in [a.fogo, a.fogo + 1]
        && n.riso in [a.riso, a.riso + 1]
        && n.amor in [a.amor, a.amor + 1];
    }
    function comentarioContado() {
      let n = request.resource.data;
      return n.diff(resource.data).affectedKeys().hasOnly(['ncoms', 'ultimoCom'])
        && n.ncoms == resource.data.get('ncoms', 0) + 1
        && n.ultimoCom.keys().hasOnly(['nome', 'texto'])
        && nomeOk(n.ultimoCom.nome)
        && textoOk(n.ultimoCom.texto, 1, 100) && !suspeito(n.ultimoCom.texto);
    }

    match /telao/{id} {
      allow read: if logado();
      allow create: if equipe()
        || (ativo()
            && request.resource.data.keys().hasOnly(['tipo', 'autor', 'nome', 'texto', 'cor', 'criado', 'reacoes', 'fotoId', 'acao', 'vaga'])
            // Ações especiais: foto marcada pro desafio ou pro concurso.
            // No concurso, a foto só entra junto com a "vaga" da pessoa na noite (uma por pessoa).
            && (!('acao' in request.resource.data)
                || (request.resource.data.tipo == 'foto' && request.resource.data.acao == 'desafio')
                || (request.resource.data.tipo == 'foto' && request.resource.data.acao == 'concurso'
                    && request.resource.data.vaga is string
                    && getAfter(/databases/$(database)/documents/concorrentes/$(request.resource.data.vaga)).data.post == id
                    && getAfter(/databases/$(database)/documents/concorrentes/$(request.resource.data.vaga)).data.de == eu()))
            // Recado: texto obrigatório. Foto: vai direto, com legenda opcional e a foto já salva em /fotos
            && ((request.resource.data.tipo == 'recado' && textoOk(request.resource.data.texto, 2, 120) && !('fotoId' in request.resource.data))
                || (request.resource.data.tipo == 'foto' && textoOk(request.resource.data.texto, 0, 80)
                    && request.resource.data.fotoId is string
                    && exists(/databases/$(database)/documents/fotos/$(request.resource.data.fotoId))))
            && corOk(request.resource.data.cor) && agora(request.resource.data)
            && request.resource.data.reacoes == {'fogo': 0, 'riso': 0, 'amor': 0}
            && !suspeito(request.resource.data.texto));
      allow update: if equipe() || (ativo() && (reacaoValida() || comentarioContado()));
      // A equipe tira qualquer post; cada pessoa pode apagar os seus (ao excluir a conta)
      allow delete: if equipe() || (logado() && resource.data.get('autor', '') == eu());

      match /comentarios/{c} {
        allow read: if logado();
        allow create: if equipe()
          || (ativo()
              && request.resource.data.keys().hasOnly(['autor', 'nome', 'texto', 'criado', 'mencoes'])
              && request.resource.data.autor == eu()
              && nomeOk(request.resource.data.nome) && textoOk(request.resource.data.texto, 1, 100)
              && agora(request.resource.data)
              && !suspeito(request.resource.data.texto)
              && exists(/databases/$(database)/documents/telao/$(id)));
        allow delete: if equipe();
      }
    }

    // ---------- Curtidas das fotos (concurso e Rolou hoje) ----------
    // id = idDoPost_quemCurtiu, então cada pessoa só curte cada foto uma vez
    match /curtidas/{id} {
      // A TV pareada também lê, pra mostrar o pódio do concurso
      allow read: if equipe() || tela() || (logado() && (resource.data.de == eu() || resource.data.para == eu()));
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['post', 'de', 'para', 'criado'])
        && request.resource.data.de == eu()
        && id == request.resource.data.post + '_' + eu()
        && request.resource.data.para == get(/databases/$(database)/documents/telao/$(request.resource.data.post)).data.autor
        && request.resource.data.para != eu()
        && agora(request.resource.data);
      allow delete: if equipe() || (logado() && resource.data.de == eu());
    }

    // ---------- Concurso: uma "vaga" por pessoa por noite (id = noite_uid) ----------
    match /concorrentes/{vaga} {
      allow read: if logado();
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['post', 'noite', 'de', 'criado'])
        && request.resource.data.de == eu()
        && request.resource.data.noite is string && request.resource.data.noite.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && vaga == request.resource.data.noite + '_' + eu()
        && existsAfter(/databases/$(database)/documents/telao/$(request.resource.data.post))
        && agora(request.resource.data);
      // Sem update: não dá pra trocar a foto que concorre. A equipe pode tirar.
      allow delete: if equipe();
    }

    // ---------- Enquete: um voto por pessoa (dá pra trocar o voto) ----------
    match /enquetes/{enq}/votos/{uid} {
      allow read: if logado();
      allow create, update: if ativo() && uid == eu()
        && request.resource.data.keys().hasOnly(['opcao', 'criado'])
        && request.resource.data.opcao is int && request.resource.data.opcao >= 0 && request.resource.data.opcao <= 3
        && request.resource.data.criado == request.time;
      allow delete: if equipe() || (logado() && uid == eu());
    }

    // ---------- Karaokê: fila da noite (todo mundo vê; a própria galera passa a vez) ----------
    match /karaoke/{id} {
      allow read: if logado();
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['autor', 'nome', 'musica', 'status', 'criado'])
        && request.resource.data.autor == eu()
        && request.resource.data.status == 'fila'
        && nomeOk(request.resource.data.nome)
        && textoOk(request.resource.data.musica, 2, 80) && !suspeito(request.resource.data.musica)
        && agora(request.resource.data);
      // A própria galera controla: quem canta termina (cantando -> feito) e o próximo sobe (fila -> cantando).
      // Também dá pra desistir da própria vez (fila -> feito). A equipe pode tudo.
      // Quem entrou na fila pode trocar a própria música enquanto espera a vez
      allow update: if ativo() && resource.data.autor == eu() && resource.data.status == 'fila'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['musica'])
        && textoOk(request.resource.data.musica, 2, 80) && !suspeito(request.resource.data.musica);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (equipe()
            || (ativo() && (
                 (resource.data.status == 'cantando' && request.resource.data.status == 'feito')
              || (resource.data.status == 'fila' && request.resource.data.status == 'cantando')
              || (resource.data.autor == eu() && resource.data.status == 'fila' && request.resource.data.status == 'feito'))));
      // Sair da fila (a pessoa) ou remover (equipe)
      allow delete: if equipe() || (logado() && resource.data.autor == eu());
    }

    // ---------- Encara ou Bebe online: mesa de amigos, cada um no seu celular ----------
    // Quem cria é o dono. Quem está na mesa mexe no jogo (o estado vai inteiro no campo st).
    // Convidado só pode entrar (se colocar em jogadores) ou recusar.
    match /mesas/{id} {
      allow read: if logado() && (resource.data.dono == eu() || eu() in resource.data.convidados || eu() in resource.data.jogadores);
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['dono', 'donoNome', 'criado', 'convidados', 'nomes', 'jogadores', 'recusados', 'semApp', 'estado', 'cfg', 'st', 'v', 'atualizado'])
        && request.resource.data.dono == eu()
        && request.resource.data.jogadores == [eu()]
        && request.resource.data.convidados is list && request.resource.data.convidados.size() <= 40
        && request.resource.data.estado == 'sala'
        && agora(request.resource.data);
      allow update: if ativo()
        && request.resource.data.dono == resource.data.dono
        && request.resource.data.criado == resource.data.criado
        && request.resource.data.convidados.size() <= 40
        && request.resource.data.jogadores.size() <= 16
        && request.resource.data.get('st', '').size() < 200000
        && (eu() in resource.data.jogadores
            || (eu() in resource.data.convidados
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jogadores', 'recusados', 'st', 'v', 'atualizado'])
                && request.resource.data.jogadores.removeAll([eu()]) == resource.data.jogadores.removeAll([eu()])));
      allow delete: if logado() && resource.data.dono == eu();
    }

    // ---------- Crush secreto (id = quemMarcou_marcado) ----------
    // Cada um só vê os próprios interesses. O do outro só dá pra ler se os dois marcaram (é assim que o match aparece).
    match /interesses/{id} {
      allow read: if logado() && (resource.data.de == eu()
        || (resource.data.para == eu() && exists(/databases/$(database)/documents/interesses/$(eu() + '_' + resource.data.de))));
      allow create, update: if ativo()
        && request.resource.data.keys().hasOnly(['de', 'para', 'criado'])
        && request.resource.data.de == eu()
        && request.resource.data.para is string && request.resource.data.para != eu()
        && id == eu() + '_' + request.resource.data.para
        && !bloqueado(eu(), request.resource.data.para)
        && agora(request.resource.data);
      allow delete: if logado() && resource.data.de == eu();
    }
    // Match: só existe se os dois interesses existem
    match /matches/{par} {
      allow read: if logado() && eu() in resource.data.membros;
      allow create, update: if ativo()
        && request.resource.data.keys().hasOnly(['membros', 'criado'])
        && request.resource.data.membros.size() == 2
        && eu() in request.resource.data.membros
        && request.resource.data.membros[0] < request.resource.data.membros[1]
        && par == request.resource.data.membros[0] + '_' + request.resource.data.membros[1]
        && exists(/databases/$(database)/documents/interesses/$(request.resource.data.membros[0] + '_' + request.resource.data.membros[1]))
        && exists(/databases/$(database)/documents/interesses/$(request.resource.data.membros[1] + '_' + request.resource.data.membros[0]))
        && agora(request.resource.data);
      allow delete: if logado() && eu() in resource.data.membros;
    }

    // ---------- Te pago um drink ----------
    // Quem oferece cria; quem recebe aceita ou recusa; quem ofereceu pode cancelar enquanto espera;
    // a equipe vê os aceitos e marca entregue/cancelado.
    match /drinks/{id} {
      allow read: if equipe() || (logado() && (resource.data.de == eu() || resource.data.para == eu()));
      allow create: if ativo()
        && request.resource.data.keys().hasOnly(['de', 'deNome', 'para', 'paraNome', 'item', 'itemNome', 'tamanho', 'preco', 'status', 'criado', 'respondido'])
        && request.resource.data.de == eu()
        && request.resource.data.para is string && request.resource.data.para != eu()
        && request.resource.data.status == 'enviado'
        && nomeOk(request.resource.data.deNome) && request.resource.data.paraNome is string && request.resource.data.paraNome.size() <= 20
        && request.resource.data.itemNome is string && request.resource.data.itemNome.size() >= 1 && request.resource.data.itemNome.size() <= 80
        && request.resource.data.preco is int && request.resource.data.preco > 0 && request.resource.data.preco < 1000000
        && request.resource.data.respondido == null
        && !bloqueado(eu(), request.resource.data.para)
        && agora(request.resource.data);
      allow update: if ativo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondido'])
        && request.resource.data.respondido == request.time
        && resource.data.status == 'enviado'
        && ((resource.data.para == eu() && request.resource.data.status in ['aceito', 'recusado'])
            || (resource.data.de == eu() && request.resource.data.status == 'cancelado'));
      allow update: if equipe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondido'])
        && resource.data.status == 'aceito'
        && request.resource.data.status in ['entregue', 'cancelado'];
      allow delete: if equipe();
    }

    // ---------- Notificações no celular: o endereço de cada aparelho (só o dono mexe; o servidor lê) ----------
    match /tokens/{uid}/aparelhos/{tok} {
      allow read, delete: if logado() && uid == eu();
      allow create, update: if pessoa() && uid == eu()
        && request.resource.data.keys().hasOnly(['criado', 'aparelho'])
        && request.resource.data.aparelho is string && request.resource.data.aparelho.size() <= 200;
    }

    // ---------- Cardápio: a equipe cadastra, todo mundo pode ver ----------
    match /cardapio/{id} {
      allow read: if true;
      allow create, update: if equipe()
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 1 && request.resource.data.nome.size() <= 60
        && request.resource.data.get('descricao', '').size() <= 200
        && request.resource.data.get('foto', '').size() < 700000;
      allow delete: if equipe();
    }

    // ---------- Posição da fila e ajustes ----------
    match /estado/{doc} {
      allow read: if logado();
      allow write: if equipe() || tela();
    }
    match /config/{doc} {
      allow read: if logado();
      allow write: if equipe();
    }
  }
}
