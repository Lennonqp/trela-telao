{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/teste/sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/teste"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/teste/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/teste/app",
      "destination": "/teste/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/dicas?agenda=1",
      "schedule": "0 16 * * *"
    }
  ]
}
